# Copy to .env.local for local development, and set the same keys in
# Vercel → Project → Settings → Environment Variables for production.
#
# Nothing here is ever sent to a browser. The site runs signed-out and
# read-only with none of it set.

# ---- Required for sign-in ------------------------------------------------
# Any long random string. Rotating it signs everybody out.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# ---- Required for saving anything ---------------------------------------
# Fine-grained personal access token, scoped to this repository only,
# with Contents: Read and write. Stores accounts, viewer data and the catalog.
GITHUB_TOKEN=
GITHUB_OWNER=e0190
GITHUB_REPO=youtubementarys
GITHUB_BRANCH=main

# ---- Who can use Studio --------------------------------------------------
# Comma-separated. With this empty, nobody can edit the catalog.
ADMIN_EMAILS=you@example.com

# ---- Optional: Sign in with Google --------------------------------------
# console.cloud.google.com → APIs & Services → Credentials → OAuth client ID
# (Web application). Authorised redirect URI:
#   https://YOUR-DOMAIN/api/auth/google/callback
#   http://localhost:8500/api/auth/google/callback   (for local development)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Optional: file uploads ---------------------------------------------
# Any S3-compatible bucket. Cloudflare R2 is the one to pick for video:
# 10 GB storage free and, unusually, no charge for bandwidth out.
#
#   R2:  https://<accountid>.r2.cloudflarestorage.com   region: auto
#   S3:  https://s3.<region>.amazonaws.com              region: eu-west-2
#
# The bucket needs public read access and a CORS rule allowing PUT from your
# site's origin — see the README.
#
# Without these, people paste a link to a file they host themselves instead.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Where objects are publicly served from, if that isn't the endpoint above.
# For R2 this is your public bucket URL or custom domain.
S3_PUBLIC_BASE_URL=

# Largest single upload. Defaults to 2 GB.
UPLOAD_MAX_BYTES=
